+// cosmo: errno differs per OS under cosmo, hence the runtime symbols; the bare numbers
+// are Windows leaking through.
+fn is_connect_in_progress(raw: i32) -> bool {
+    unsafe extern "C" {
+        #[link_name = "EINPROGRESS"]
+        static COSMO_EINPROGRESS: core::ffi::c_int;
+        #[link_name = "EWOULDBLOCK"]
+        static COSMO_EWOULDBLOCK: core::ffi::c_int;
+        #[link_name = "EAGAIN"]
+        static COSMO_EAGAIN: core::ffi::c_int;
+    }
+    let (einprogress, ewouldblock, eagain) =
+        unsafe { (COSMO_EINPROGRESS, COSMO_EWOULDBLOCK, COSMO_EAGAIN) };
+    raw == einprogress
+        || raw == ewouldblock
+        || raw == eagain
+        || raw == 10035 // WSAEWOULDBLOCK
+        || raw == 10036 // WSAEINPROGRESS
+        || raw == 10037 // WSAEALREADY
+}
