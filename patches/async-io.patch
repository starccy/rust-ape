+fn cosmo_o_nonblock() -> rustix::fs::OFlags {
+    unsafe extern "C" {
+        #[link_name = "O_NONBLOCK"]
+        static VALUE: core::ffi::c_int;
+    }
+    rustix::fs::OFlags::from_bits_retain(unsafe { VALUE } as u32)
+}
+
+fn cosmo_socket_flags() -> rn::SocketFlags {
+    unsafe extern "C" {
+        #[link_name = "SOCK_NONBLOCK"]
+        static NONBLOCK: core::ffi::c_int;
+        #[link_name = "SOCK_CLOEXEC"]
+        static CLOEXEC: core::ffi::c_int;
+    }
+    rn::SocketFlags::from_bits_retain(unsafe { NONBLOCK | CLOEXEC } as u32)
+}
