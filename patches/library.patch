+// cosmo: errno is whatever the host uses (WSA codes on Windows), so the match
+// below sends everything to Uncategorized — and an unrecognized EWOULDBLOCK
+// turns non-blocking IO into a hard error. Try the runtime symbols first.
+fn cosmo_decode_error_kind(errno: i32) -> Option<io::ErrorKind> {
+    use io::ErrorKind::*;
+    unsafe extern "C" {
+        #[link_name = "EAGAIN"]
+        static EAGAIN: c_int;
+        #[link_name = "EWOULDBLOCK"]
+        static EWOULDBLOCK: c_int;
+        #[link_name = "EINPROGRESS"]
+        static EINPROGRESS: c_int;
+        #[link_name = "ECONNREFUSED"]
+        static ECONNREFUSED: c_int;
+        #[link_name = "ECONNRESET"]
+        static ECONNRESET: c_int;
+        #[link_name = "ECONNABORTED"]
+        static ECONNABORTED: c_int;
+        #[link_name = "ETIMEDOUT"]
+        static ETIMEDOUT: c_int;
+        #[link_name = "ENETUNREACH"]
+        static ENETUNREACH: c_int;
+        #[link_name = "ENETDOWN"]
+        static ENETDOWN: c_int;
+        #[link_name = "EHOSTUNREACH"]
+        static EHOSTUNREACH: c_int;
+        #[link_name = "ENOTCONN"]
+        static ENOTCONN: c_int;
+        #[link_name = "EADDRINUSE"]
+        static EADDRINUSE: c_int;
+        #[link_name = "EADDRNOTAVAIL"]
+        static EADDRNOTAVAIL: c_int;
+        #[link_name = "EPIPE"]
+        static EPIPE: c_int;
+        #[link_name = "EINTR"]
+        static EINTR: c_int;
+        #[link_name = "EINVAL"]
+        static EINVAL: c_int;
+        #[link_name = "EACCES"]
+        static EACCES: c_int;
+        #[link_name = "EPERM"]
+        static EPERM: c_int;
+        #[link_name = "ENOENT"]
+        static ENOENT: c_int;
+        #[link_name = "EEXIST"]
+        static EEXIST: c_int;
+        #[link_name = "ENOSYS"]
+        static ENOSYS: c_int;
+    }
+    let e = errno as c_int;
+    // EWOULDBLOCK and EAGAIN may well be the same value here.
+    let table: [(c_int, io::ErrorKind); 21] = unsafe {
+        [
+            (EAGAIN, WouldBlock),
+            (EWOULDBLOCK, WouldBlock),
+            (EINPROGRESS, InProgress),
+            (ECONNREFUSED, ConnectionRefused),
+            (ECONNRESET, ConnectionReset),
+            (ECONNABORTED, ConnectionAborted),
+            (ETIMEDOUT, TimedOut),
+            (ENETUNREACH, NetworkUnreachable),
+            (ENETDOWN, NetworkDown),
+            (EHOSTUNREACH, HostUnreachable),
+            (ENOTCONN, NotConnected),
+            (EADDRINUSE, AddrInUse),
+            (EADDRNOTAVAIL, AddrNotAvailable),
+            (EPIPE, BrokenPipe),
+            (EINTR, Interrupted),
+            (EINVAL, InvalidInput),
+            (EACCES, PermissionDenied),
+            (EPERM, PermissionDenied),
+            (ENOENT, NotFound),
+            (EEXIST, AlreadyExists),
+            (ENOSYS, Unsupported),
+        ]
+    };
+    for &(val, kind) in table.iter() {
+        if e == val {
+            return Some(kind);
+        }
+    }
+    None
+}
+
